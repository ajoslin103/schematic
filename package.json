{
  "name": "@ajoslin103/schematic",
  "version": "0.2.1",
  "description": "A FabricJS library, facilitating working above coordinate planes",
  "type": "module",
  "main": "dist/schematic.cjs.js",
  "module": "dist/schematic.esm.js",
  "browser": "dist/schematic.umd.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/schematic.esm.js",
      "require": "./dist/schematic.cjs.js",
      "browser": "./dist/schematic.umd.js",
      "default": "./dist/schematic.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "npm run build && (npm run watch & npm run serve)",
    "watch": "rollup -c -w",
    "serve": "browser-sync start --server --files 'dist/**/*.js,demo/**/*.html' --startPath demo/grid-demo.html",
    "dev:old": "browser-sync start --server --files 'src/**/*.js,demo/**/*.html' --startPath demo/grid-demo.html",
    "prepublishOnly": "yarn build",
    "publish:npm": "npm publish --access public",
    "publish:jsr": "npx jsr publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajoslin103/schematic.git"
  },
  "keywords": [
    "fabric",
    "canvas",
    "grid",
    "schematic",
    "interactive"
  ],
  "author": "Allen Joslin <ajoslin103@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "fabric": "^6.7.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "browser-sync": "^3.0.4",
    "rollup": "^4.22.4"
  }
}
